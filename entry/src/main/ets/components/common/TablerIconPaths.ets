/**
 * 按名称查找图标路径数据。
 * @returns IconPathData 或 undefined（未找到时）
 */
export function findIconPath(name: string): IconPathData | undefined {
  for (let i = 0; i < TABLER_ICONS.length; i++) {
    if (TABLER_ICONS[i].name === name) {
      return TABLER_ICONS[i].pathData;
    }
  }
  return undefined;
}
