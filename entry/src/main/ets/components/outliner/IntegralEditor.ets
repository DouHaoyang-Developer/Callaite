import { hilog } from '@kit.PerformanceAnalysisKit';
import { TablerIcon } from '../common/Icons';
import { LivePreviewHelper } from '../../utils/LivePreviewHelper';
import { MarkdownExporter } from '../../core/parser/MarkdownExporter';
import { WorkspaceService } from '../../services/WorkspaceService';
import { SaveQueue } from '../../services/SaveQueue';
import { AppState } from '../../state/AppState';
import { promptAction } from '@kit.ArkUI';

/**
 * IntegralEditor —— 整页四模式编辑器（O4，参照 Lunius MarkdownEditor）。
 *
 * 模式：live（实时阅览，光标感知语法隐藏）/ source（源码着色）/ preview（阅读）/ split（分屏）。
 * 架构：原生 RichEditor 整页承载页面 Markdown；「应用并重建大纲」将 Markdown
 * 经 MarkdownParser 重建页面块（页面身份保持），随后回到块级视图。
 * 保存链：变更 → replacePageBlocks → SaveQueue.markDirty（即时持久化）。
 */
interface PreviewLine {
  /**
   * 行序号。**必须**作为 ForEach 的 key 的一部分：
   * 预览行按 `text + size` 生成 key 时，内容重复的行（如 16 行相同的 TODO）会产生
   * 重复 key —— ArkUI 直接报 `Ids generated by the ForEach id gen function must be
   * unique` 并**只渲染其中一行**（实测分屏右栏 16 行只显示 1 行）。
   */
  id: number;
  text: string;
  size: number;
  weight: FontWeight;
  color: ResourceColor;
  indent: number;
  bullet: boolean;
}

@Component
export struct IntegralEditor {
  @Prop pageName: string = '';
  onClose: () => void = () => {};
  @State viewMode: string = 'live';
  @State markdown: string = '';
  @State previewLines: PreviewLine[] = [];
  private richController: RichEditorController = new RichEditorController();
  private livePreview: LivePreviewHelper = new LivePreviewHelper();
  private editorCaretOffset: number = -1;
  /**
   * 上一次重建 span 所用的（文本, 光标）快照。
   *
   * ⚠️ 必须按「输入是否真的变了」短路重建，否则会自激：
   * addTextSpan 改字号/底色 → 光标像素位置变化 → onSelectionChange 回调 →
   * rebuildSpans → 再次 addTextSpan → …（实测：在 `**bold**` 标记内点击后，
   * 200ms 内 buildSpans 重入 4 次，最终 `Stack overflow!` 且编辑器被清成空白）。
   * 由于 span 渲染**只依赖** (text, caretOffset) 这两个输入，二者不变时重建是纯浪费
   * 且有自激风险，直接跳过。
   */
  private lastSpanText: string = '';
  private lastSpanCaret: number = -2;
  /** rebuildSpans 重入闸（含 setCaretOffset 触发的同步回调窗口），见 rebuildSpans 注释 */
  private isRebuildingSpans: boolean = false;
  private pageUuid: string = '';
  private static readonly TAG = 'IntegralEditor';
  private static readonly DOMAIN = 0x0002;

  aboutToAppear(): void {
    const ws = WorkspaceService.getInstance();
    const page = ws.getPageByName(this.pageName);
    if (page) {
      this.pageUuid = page.uuid;
      // 用「全页块」导出 markdown：getPageBlocks 仅顶层且走 childrenMap 查表，
      // 实测在该路径下取到空列表 → markdown 为空 → 编辑器空白、应用被拒。
      let blocks = ws.getAllPageBlocks(page.uuid);
      if (blocks.length === 0) {
        blocks = ws.getPageBlocks(page.uuid);
      }
      this.markdown = MarkdownExporter.export(page, blocks);
      console.info('[IntegralEditor] loaded page=' + page.name
        + ' blocks=' + blocks.length.toString()
        + ' mdLen=' + this.markdown.length.toString());
    } else {
      console.error('[IntegralEditor] page not found: ' + this.pageName);
    }
    this.rebuildPreview();
  }

  private rebuildPreview(): void {
    const lines = this.markdown.split('\n');
    const out: PreviewLine[] = [];
    let inCode = false;
    for (let i = 0; i < lines.length; i++) {
      const raw = lines[i];
      if (raw.startsWith('```')) {
        inCode = !inCode;
        out.push({ id: out.length, text: inCode ? '┌ 代码块' : '└', size: 11, weight: FontWeight.Normal,
          color: $r('app.color.muted_text'), indent: 0, bullet: false });
        continue;
      }
      if (inCode) {
        // 与 LivePreviewHelper.codeLineStyle() 共用同一 token（原为内联 '#6A5ACD'，
        // 暗色下在 #202020 底上仅 ≈2.7:1，偏暗）
        out.push({ id: out.length, text: raw, size: 13, weight: FontWeight.Normal,
          color: $r('app.color.lp_code'), indent: 12, bullet: false });
        continue;
      }
      if (raw.startsWith('### ')) {
        out.push({ id: out.length, text: raw.substring(4), size: 19, weight: FontWeight.Bold,
          color: $r('app.color.text'), indent: 0, bullet: false });
      } else if (raw.startsWith('## ')) {
        out.push({ id: out.length, text: raw.substring(3), size: 22, weight: FontWeight.Bold,
          color: $r('app.color.text'), indent: 0, bullet: false });
      } else if (raw.startsWith('# ')) {
        out.push({ id: out.length, text: raw.substring(2), size: 26, weight: FontWeight.Bold,
          color: $r('app.color.text'), indent: 0, bullet: false });
      } else if (raw.startsWith('- ') || raw.startsWith('* ')) {
        out.push({ id: out.length, text: raw.substring(2), size: 15, weight: FontWeight.Normal,
          color: $r('app.color.text'), indent: 16, bullet: true });
      } else if (raw.startsWith('> ')) {
        out.push({ id: out.length, text: raw.substring(2), size: 14, weight: FontWeight.Normal,
          color: $r('app.color.primary'), indent: 16, bullet: false });
      } else if (raw.trim() !== '') {
        out.push({ id: out.length, text: raw, size: 15, weight: FontWeight.Normal,
          color: $r('app.color.text'), indent: 0, bullet: false });
      }
    }
    this.previewLines = out;
  }

  /**
   * 编辑器当前文本；编辑器未挂载（阅读模式）或刚重建为空时，以 this.markdown 为准。
   * ⚠️ 不能直接用 extractText：切换模式会重建 RichEditor，新控制器内容为空。
   */
  private currentText(): string {
    if (this.viewMode === 'preview') {
      return this.markdown;
    }
    const t = LivePreviewHelper.extractText(this.richController);
    return t !== '' ? t : this.markdown;
  }

  /**
   * 把编辑器纯文本转换为 MarkdownParser 能识别的 markdown（Logseq 块格式）。
   *
   * ⚠️ 关键约定（D-Gate 1 判据②「getSpans() 还原缩进」的依据）：
   * RichEditor 里存的就是**原始 markdown 文本** —— `- ` 块前缀与每级 2 空格的缩进
   * 都在 span 的 value 里，live 模式只是按光标位置给前缀改色/隐藏，文本本身不动。
   * 因此 `LivePreviewHelper.extractText()`（`RichEditorController.getSpans()` 求和）
   * **天然读回含缩进层级的原文**，不需要另建缩进映射。
   * 前提是 `buildSpans` 不得吞掉 `\n`（见 LivePreviewHelper.buildSpansInternal 的修复）。
   *
   * 本函数只做「兜底补前缀」：用户在 RichEditor 里按回车新建的行不带 `- `
   * （RichEditor 不会自动续块前缀），而 MarkdownParser 会把无前缀行当作上一块的
   * **续行**，于是静默并块。
   *
   * 逐行判定（原实现是「只要有一行以 `- ` 开头就整体原样返回」，混合场景下
   * 无前缀行会被静默并掉）：
   *   - 已是块行（`- `/`* `/`+ ` 开头）→ 原样保留，并记下它的缩进；
   *   - 非块行且缩进 **≤ 最近一个块行**的缩进 → 视作用户新敲的块，补 `- `；
   *   - 非块行但缩进更深 → 视作多行块的续行，原样保留
   *     （MarkdownExporter 的续行恒为 `块的缩进 + 2`，必然更深，故不会被误补）。
   */
  private toMarkdown(text: string): string {
    if (text.trim() === '') {
      return '';
    }
    const lines: string[] = text.split('\n');
    const out: string[] = [];
    let lastBlockIndent = -1;
    for (let i = 0; i < lines.length; i++) {
      const l = lines[i];
      if (l.trim() === '') {
        continue;
      }
      let indentLen = 0;
      while (indentLen < l.length && l.charAt(indentLen) === ' ') {
        indentLen++;
      }
      const body = l.substring(indentLen);
      const isBlockLine = body.startsWith('- ') || body.startsWith('* ') || body.startsWith('+ ');
      if (isBlockLine) {
        out.push(l);
        lastBlockIndent = indentLen;
      } else if (lastBlockIndent < 0 || indentLen <= lastBlockIndent) {
        out.push(l.substring(0, indentLen) + '- ' + body);
        lastBlockIndent = indentLen;
      } else {
        out.push(l);
      }
    }
    return out.join('\n');
  }

  /** 应用 Markdown → 重建页面块（身份保持）→ 即时持久化 */
  private applyAndRebuild(): void {
    const text = this.toMarkdown(this.currentText());
    // 防误删硬闸 1：空内容不得覆盖已有块。
    if (text.trim() === '') {
      promptAction.openToast({ message: '内容为空，已取消重建' });
      return;
    }
    // 防误删硬闸 2（结构塌缩）：DataStore 的闸门只挡「解析出 0 个块」，挡不住
    // 「整页塌成一行 → 解析出 1 个块」。历史缺陷（buildSpans 吞 `\n`）正是这样把
    // 6 块的页面写成 1 块（实测 71B → 66B）。此处按「原页面多块 而 待写入文本仅一行」
    // 直接拒绝，与数据层闸门形成互补。
    const ws = WorkspaceService.getInstance();
    let oldCount = ws.getAllPageBlocks(this.pageUuid).length;
    if (oldCount === 0) {
      oldCount = ws.getPageBlocks(this.pageUuid).length;
    }
    if (oldCount > 1 && text.indexOf('\n') < 0) {
      console.error('[IntegralEditor] replacePageBlocks refused: text collapsed to a single line,'
        + ' page had ' + oldCount.toString() + ' blocks, len=' + text.length.toString());
      promptAction.openToast({ message: '重建被拒绝：内容塌缩为单行，已保护原页面' });
      return;
    }
    const ok = ws.replacePageBlocks(this.pageUuid, text);
    if (ok) {
      SaveQueue.getInstance().markDirty();
      promptAction.openToast({ message: '大纲已重建' });
      this.onClose();
    } else {
      // 数据层防误删闸门拒绝（解析结果为空而原页面有块）时走这里
      promptAction.openToast({ message: '重建被拒绝：内容解析为空，已保护原页面' });
    }
  }

  private rebuildSpans(): void {
    if (this.isRebuildingSpans || this.livePreview.getIsRebuilding()) {
      return;
    }
    // ★ 重入闸必须在**整个方法**期间生效（含下面的 setCaretOffset）。
    //   setCaretOffset 会**同步**回调 onSelectionChange；if 此时快照尚未写入，
    //   handleSelectionChange 会再次触发 rebuildSpans → 无限同步递归，4~5 层后
    //   `Stack overflow!`，而 deleteSpans 已经执行、回填尚未完成 → 编辑器被清成空白。
    //   （实测：live 模式、内容非空时点进编辑器即 100% 复现。）
    this.isRebuildingSpans = true;
    try {
      const caret = this.editorCaretOffset;
      // 关键（判据②：分屏空白 / getSpans() 还原缩进）：
      // onReady 时编辑器是新创建的空实例，extractText 返回 ''。此时必须用 this.markdown
      // 回填，否则会把空内容写回编辑器 → onDidChange → markdown 被清空 → 整页内容丢失。
      // 分屏模式同样要走这条回填（原先漏了，导致分屏左栏空白）。
      //
      // 回填后 buildSpans 把 this.markdown 原文**逐段**写进跨度（含 `- ` 前缀与 `  ` 缩进），
      // 因此后续 extractText/getSpans() 读回的就是带缩进层级的完整 markdown。
      const extracted = LivePreviewHelper.extractText(this.richController);
      const text = extracted !== '' ? extracted : this.markdown;
      if (this.viewMode === 'live' || this.viewMode === 'split') {
        this.livePreview.buildSpans(this.richController, text, caret);
      } else if (this.viewMode === 'source') {
        this.livePreview.buildSourceSpans(this.richController, text);
      }
      // 快照先写、再动光标：见上面的重入说明。
      this.lastSpanText = text;
      this.lastSpanCaret = caret;
      if (caret >= 0 && caret <= text.length) {
        this.richController.setCaretOffset(caret);
      }
    } finally {
      this.isRebuildingSpans = false;
    }
  }

  private handleEditorChange(): void {
    if (this.livePreview.getIsRebuilding()) {
      return;
    }
    const t = LivePreviewHelper.extractText(this.richController);
    // 防误删：编辑器重建期间的「空提取」不得覆盖非空 markdown。
    // （用户真正清空全文的场景极少，且删除到只剩空行时 extractText 通常仍含换行；
    //   以「宁可保留旧内容」为代价换取绝不会静默清空整页。）
    //
    // 追加「结构塌缩」防护：新建 RichEditor 的 onReady → buildSpans 若吞掉 `\n`
    // （历史缺陷），第一次 onDidChange 会把整页塌成单行并回写 this.markdown，
    // 随后点「应用并重建」即以 1 个块覆盖整页。多行的原值不得被单行的提取覆盖。
    if (t !== '' || this.markdown === '') {
      const collapsed = t.indexOf('\n') < 0 && this.markdown.indexOf('\n') >= 0;
      if (collapsed) {
        console.error('[IntegralEditor] refused collapsed extraction len=' + t.length.toString());
      } else {
        this.markdown = t;
      }
    }
    if (this.viewMode === 'live' || this.viewMode === 'source') {
      // 文本没变就不重建：addTextSpan 本身会再次触发 onDidChange，无此短路会自激
      if (this.markdown !== this.lastSpanText) {
        this.rebuildSpans();
      }
    }
    if (this.viewMode === 'split') {
      this.rebuildPreview();
    }
  }

  private handleSelectionChange(): void {
    if (this.livePreview.getIsRebuilding()) {
      return;
    }
    try {
      this.editorCaretOffset = this.richController.getCaretOffset();
    } catch (e) {
      this.editorCaretOffset = -1;
    }
    if (this.viewMode === 'live') {
      // 光标没动就不重建（同 handleEditorChange 的短路理由）
      if (this.editorCaretOffset !== this.lastSpanCaret) {
        this.rebuildSpans();
      }
    }
  }

  @Builder
  ModeButton(mode: string, label: string) {
    Text(label)
      .fontSize(12)
      .fontColor(this.viewMode === mode ? $r('app.color.primary') : $r('app.color.muted_text'))
      .padding({ left: 10, right: 10, top: 5, bottom: 5 })
      .borderRadius(6)
      .backgroundColor(this.viewMode === mode ? $r('app.color.surface2') : Color.Transparent)
      .onClick(() => {
        const prev = this.viewMode;
        this.viewMode = mode;
        if (prev !== mode) {
          if (mode === 'live' || mode === 'source') {
            this.rebuildSpans();
          } else {
            this.rebuildPreview();
          }
        }
      })
  }

  @Builder
  PreviewPane() {
    Scroll() {
      Column({ space: 6 }) {
        ForEach(this.previewLines, (line: PreviewLine) => {
          Row({ space: 6 }) {
            if (line.bullet) {
              Circle({ width: 5, height: 5 }).fill($r('app.color.bullet')).margin({ top: 8 })
            }
            Text(line.text)
              .fontSize(line.size)
              .fontWeight(line.weight)
              .fontColor(line.color)
              .layoutWeight(1)
          }
          .width('100%')
          .padding({ left: line.indent })
        }, (line: PreviewLine) => line.id.toString())
      }
      .width('100%')
      .padding(16)
      .alignItems(HorizontalAlign.Start)
    }
    .width('100%')
    .height('100%')
    .scrollBar(BarState.Auto)
    .align(Alignment.TopStart)
  }

  build() {
    Column({ space: 0 }) {
      // ─── 顶部：页名 + 模式切换 + 应用 ───
      Row({ space: 8 }) {
        Text(this.pageName)
          .fontSize(14)
          .fontWeight(FontWeight.Medium)
          .fontColor($r('app.color.text'))
          .layoutWeight(1)
          .maxLines(1)
        this.ModeButton('live', '实时')
        this.ModeButton('source', '源码')
        this.ModeButton('preview', '阅读')
        this.ModeButton('split', '分屏')
        Row() {
          TablerIcon('check', 14, $r('app.color.on_primary'))
        }
        .width(30)
        .height(30)
        .justifyContent(FlexAlign.Center)
        .alignItems(VerticalAlign.Center)
        .borderRadius(6)
        .backgroundColor($r('app.color.primary'))
        .onClick(() => {
          this.applyAndRebuild();
        })
        Row() {
          TablerIcon('x', 14, $r('app.color.muted_text'))
        }
        .width(30)
        .height(30)
        .justifyContent(FlexAlign.Center)
        .alignItems(VerticalAlign.Center)
        .borderRadius(6)
        .onClick(() => {
          this.onClose();
        })
      }
      .width('100%')
      .padding({ left: 16, right: 12, top: 8, bottom: 8 })
      .border({ width: { bottom: 1 }, color: $r('app.color.border') })

      // ─── 内容区（按模式）───
      if (this.viewMode === 'split') {
        Row({ space: 0 }) {
          Column({ space: 0 }) {
            RichEditor({ controller: this.richController })
              .onReady(() => {
                this.rebuildSpans();
              })
              .onDidChange(() => {
                this.handleEditorChange();
              })
              .onSelectionChange(() => {
                this.handleSelectionChange();
              })
              .width('100%')
              .height('100%')
              .padding({ left: 12, right: 8 })
          }
          .layoutWeight(1)
          .height('100%')
          .border({ width: { right: 1 }, color: $r('app.color.border') })

          Column({ space: 0 }) {
            this.PreviewPane()
          }
          .layoutWeight(1)
          .height('100%')
        }
        .width('100%')
        .layoutWeight(1)
      } else if (this.viewMode === 'preview') {
        this.PreviewPane()
      } else {
        // live / source：整页 RichEditor
        RichEditor({ controller: this.richController })
          .onReady(() => {
            this.rebuildSpans();
          })
          .onDidChange(() => {
            this.handleEditorChange();
          })
          .onSelectionChange(() => {
            this.handleSelectionChange();
          })
          .width('100%')
          .layoutWeight(1)
          .padding({ left: 16, right: 16, top: 8 })
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor($r('app.color.surface0'))
  }
}
